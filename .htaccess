# 35.veganlife.gr — static campaign page + supporters-api
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

Options -Indexes
AddDefaultCharset UTF-8

# Σημείωση: δεν βάζουμε frame-ancestors, γιατί το embed του Hostinger builder είναι sandboxed
# iframe (opaque origin) και θα μπλοκαριζόταν. Η σελίδα δεν έχει login ή φόρμες με δεδομένα.
<IfModule mod_headers.c>
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<FilesMatch "^(README\.md|builder-embed\.html|builder-custom-code\.html|\.gitignore)$">
  Require all denied
</FilesMatch>
